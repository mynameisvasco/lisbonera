// Only read by @sveltejs/adapter-cloudflare to know where to write the SvelteKit worker.
// The deployed Worker is configured in wrangler.jsonc; its entry (src/worker.ts) wraps this output.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lisbonera",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-21",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
