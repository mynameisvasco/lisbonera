{
	"name": "lisbonera",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --strict-vars=false --check && vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --strict-vars=false --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p test --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"gen": "wrangler types --strict-vars=false",
		"deploy": "pnpm build && wrangler d1 migrations apply DB --remote && wrangler deploy",
		"db:migrate": "wrangler d1 migrations apply DB --local"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.6",
		"@eslint/js": "^10.0.1",
		"@jellyfin/sdk": "^1.0.1",
		"@msw/cloudflare": "^0.2.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"msw": "^3.0.3",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"jose": "^6.2.13",
		"zod": "^4.6.7"
	}
}
