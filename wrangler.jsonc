{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lisbonera",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-21",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lisbonera",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "LOGIN_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"secrets": {
		"required": ["ENCRYPTION_KEY", "ACCESS_TEAM_DOMAIN", "ACCESS_AUD", "ADMIN_EMAIL"]
	},
	"vars": {
		"JELLYFIN_USERNAME": "admin"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"preview_urls": false
}
